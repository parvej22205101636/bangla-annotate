# MongoDB Atlas connection string (free M0 cluster is enough)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/bangla-annotate
# Long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# The account registered with this e-mail becomes the admin
ADMIN_EMAIL=you@example.com
# Frontend address(es), comma separated
CLIENT_URL=http://localhost:5173
PORT=5000
